/* app.wxss — PingChang 平常 全局样式 */

page {
  --color-primary: #5C3D20;
  --color-accent: #C4622D;
  --color-bg: #F5EFE0;
  --color-paper: #EDE0C4;
  --color-ink: #3A2A1A;
  --color-ink-secondary: #7A5C3E;
  --color-seal: #B5341E;
  --color-gold: #C9A66B;

  /* 情绪颜色 */
  --m-happy: #C4622D;
  --m-calm: #2E6E65;
  --m-sad: #5A3D7A;
  --m-anxious: #8C5E00;
  --m-mixed: #7A5C3E;

  background-color: var(--color-bg);
  font-family: 'Noto Serif SC', serif;
  color: var(--color-ink);
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 卡片通用样式 */
.card {
  background-color: var(--color-paper);
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(58, 42, 26, 0.08);
  padding: 24rpx;
}

/* 按钮基础样式 */
.btn {
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  border: none;
}

.btn-primary {
  background-color: var(--color-primary);
  color: #ffffff;
}

.btn-accent {
  background-color: var(--color-accent);
  color: #ffffff;
}

.btn-ghost {
  background-color: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.btn[disabled] {
  opacity: 0.4;
}

/* 标签样式 */
.tag {
  border-radius: 20rpx;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  background-color: var(--color-paper);
  color: var(--color-ink-secondary);
  border: 1rpx solid var(--color-gold);
}

.tag-active {
  background-color: var(--color-primary);
  color: #ffffff;
  border-color: var(--color-primary);
}

/* 分区标题 */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-primary);
  margin-bottom: 16rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: var(--color-ink-secondary);
}

.empty-state text {
  font-size: 26rpx;
  margin-top: 20rpx;
  text-align: center;
  line-height: 1.6;
}

/* 加载态 */
.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background-color: var(--color-paper);
  margin: 20rpx 0;
}

/* 全局文字截断 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
