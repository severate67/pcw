<!-- components/trend-chart/index.wxml — 情绪折线图 -->
<view class="chart-wrap">

  <!-- wx-charts canvas -->
  <canvas
    canvas-id="trend-chart-canvas"
    class="chart-canvas"
    bindtouchstart="onTouchStart"
    bindtouchend="onTouchEnd"
  />

  <!-- 无数据占位（数据加载中或为空时显示） -->
  <view wx:if="{{!chartInited}}" class="chart-placeholder">
    <text class="placeholder-text">情绪折线图（需引入 wx-charts）</text>
  </view>

</view>
