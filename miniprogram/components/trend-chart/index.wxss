/* components/trend-chart/index.wxss — 情绪折线图样式 */

.chart-wrap {
  position: relative;
  width: 100%;
  height: 200rpx;
}

.chart-canvas {
  width: 100%;
  height: 200rpx;
}

.chart-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-bg);
  border-radius: 8rpx;
  border: 1rpx dashed var(--color-gold);
}

.placeholder-text {
  font-size: 22rpx;
  color: var(--color-ink-secondary);
  opacity: 0.7;
}
