/* components/mood-widget/index.wxss — 情绪记录组件样式 */

.mood-widget {
  width: 100%;
}

.emotion-select {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.emotion-item {
  padding: 0 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--color-ink-secondary);
  background-color: var(--color-bg);
  border: 2rpx solid var(--color-gold);
  transition: transform 0.15s ease;
}

.emotion-selected {
  transform: scale(1.05);
  font-weight: bold;
}

.intensity-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.intensity-label {
  font-size: 24rpx;
  color: var(--color-ink-secondary);
  flex-shrink: 0;
}

.intensity-dots {
  display: flex;
  gap: 16rpx;
}

.intensity-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background-color: var(--color-paper);
  border: 2rpx solid var(--color-gold);
}

.dot-filled {
  background-color: var(--color-accent);
  border-color: var(--color-accent);
}

.intensity-hint {
  font-size: 22rpx;
  color: var(--color-ink-secondary);
}

.diary-section {
  margin-bottom: 20rpx;
}

.diary-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.diary-label {
  font-size: 24rpx;
  color: var(--color-ink-secondary);
}

.diary-count {
  font-size: 22rpx;
  color: var(--color-ink-secondary);
}

.count-warn {
  color: var(--color-accent);
}

.diary-input {
  width: 100%;
  min-height: 100rpx;
  font-size: 26rpx;
  color: var(--color-ink);
  line-height: 1.8;
  background-color: var(--color-bg);
  border-radius: 8rpx;
  padding: 16rpx;
  border: 1rpx solid var(--color-gold);
}

.placeholder {
  color: var(--color-ink-secondary);
  opacity: 0.5;
}

.diary-hint {
  font-size: 22rpx;
  color: var(--color-accent);
  margin-top: 6rpx;
  display: block;
}

.save-btn {
  width: 100%;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 12rpx;
}

.btn-disabled {
  opacity: 0.4;
}
