/* components/seal-stamp/index.wxss — 蜡封印章样式 */

.stamp-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stamp-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--color-seal);
}

.stamp-sealed .stamp-circle {
  background-color: transparent;
  opacity: 0.4;
}

.stamp-open .stamp-circle {
  background-color: var(--color-seal);
  opacity: 1;
  box-shadow: 0 4rpx 12rpx rgba(181, 52, 30, 0.4);
}

.stamp-char {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--color-seal);
}

.stamp-open .stamp-char {
  color: #ffffff;
}

.stamp-label {
  font-size: 18rpx;
  color: var(--color-ink-secondary);
}
