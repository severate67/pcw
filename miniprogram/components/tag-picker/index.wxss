/* components/tag-picker/index.wxss — 标签选择器样式 */

.tag-picker-wrap {
  width: 100%;
}

.tags-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.tag-option {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #7A5C3E;
  background-color: #F5EFE0;
  border: 2rpx solid #C9A66B;
}

.tag-selected {
  background-color: #5C3D20;
  color: #ffffff;
  border-color: #5C3D20;
}

.tag-hint {
  font-size: 22rpx;
  color: #7A5C3E;
  display: block;
  text-align: center;
}
