<!-- components/tag-picker/index.wxml — 标签选择器 -->
<view class="tag-picker-wrap">
  <view class="tags-grid">
    <view
      wx:for="{{presetTags}}"
      wx:key="*this"
      class="tag-option {{_selected.indexOf(item) >= 0 ? 'tag-selected' : ''}}"
      style="{{_selected.indexOf(item) >= 0 ? 'background-color:#5C3D20;color:#ffffff;border-color:#5C3D20;' : ''}}"
      bindtap="toggleTag"
      data-tag="{{item}}"
    >
      <text>{{item}}</text>
    </view>
  </view>
  <text class="tag-hint">已选 {{_selected.length}} 个（需{{min}}-{{max}}个）</text>
</view>
