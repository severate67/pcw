/* components/emotion-calendar/index.wxss — 情绪月历样式 */

.calendar-wrap {
  background-color: var(--color-paper);
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(58, 42, 26, 0.08);
}

.weekday-row {
  display: flex;
  margin-bottom: 8rpx;
}

.weekday-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-ink-secondary);
  padding: 8rpx 0;
}

.weeks-container {}

.week-row {
  display: flex;
}

.day-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 4rpx;
  min-height: 80rpx;
}

.day-empty {
  pointer-events: none;
}

.day-future {
  opacity: 0.3;
}

.day-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
  background-color: transparent;
  margin-bottom: 4rpx;
  border: 1rpx solid var(--color-gold);
}

.day-num {
  font-size: 24rpx;
  color: var(--color-ink);
}

.day-today .day-num {
  color: var(--color-accent);
  font-weight: bold;
}

.day-today {
  position: relative;
}

.day-today::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--color-accent);
}

.legend-row {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-bg);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
}

.legend-item text {
  font-size: 20rpx;
  color: var(--color-ink-secondary);
}
