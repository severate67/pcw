<!-- components/envelope-card/index.wxml — 信封卡片 -->
<view class="envelope-card" bindtap="onTap">

  <!-- 未读红点 -->
  <view wx:if="{{showUnread && letter && letter.status === 'sent'}}" class="unread-dot"></view>

  <!-- 信封头部装饰 -->
  <view class="envelope-top">
    <view class="envelope-flap"></view>
  </view>

  <!-- 信件内容 -->
  <view class="envelope-body">

    <!-- 寄信人 -->
    <view class="sender-row">
      <view class="sender-avatar">
        <text class="avatar-char">{{letter && letter.senderNickname ? letter.senderNickname[0] : '匿'}}</text>
      </view>
      <view class="sender-info">
        <text class="sender-name">{{letter ? (letter.senderNickname || '陌生人') : ''}}</text>
        <text class="letter-time">{{timeDisplay}}</text>
      </view>
      <view class="status-badge status-{{letter ? letter.status : ''}}">
        <text>{{letter && letter.status === 'sent' ? '未读' : (letter && letter.status === 'read' ? '已读' : '')}}</text>
      </view>
    </view>

    <!-- 标题 -->
    <view wx:if="{{letter && letter.title}}" class="letter-title">
      <text>{{letter.title}}</text>
    </view>

    <!-- 摘要 -->
    <view class="letter-excerpt">
      <text class="excerpt-text text-ellipsis-2">{{letter ? letter.content : ''}}</text>
    </view>

    <!-- 底部字数信息 -->
    <view class="letter-meta">
      <text class="word-count">{{letter ? letter.word_count : 0}} 字</text>
    </view>

  </view>

</view>
