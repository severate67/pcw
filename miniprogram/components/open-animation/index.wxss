/* components/open-animation/index.wxss — 拆信动画样式 */

.anim-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background-color: var(--color-bg);
}

.envelope-wrap {
  position: relative;
  width: 560rpx;
  height: 400rpx;
}

.envelope-body-bg {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background-color: var(--color-paper);
  border-radius: 8rpx;
  box-shadow: 0 8rpx 32rpx rgba(58, 42, 26, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.seal-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: var(--color-seal);
  display: flex;
  align-items: center;
  justify-content: center;
  transform-origin: center;
}

.seal-char {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}

.envelope-flap-anim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  transform-origin: top center;
  transform-style: preserve-3d;
}

.flap-inner {
  width: 100%;
  height: 100%;
  background-color: var(--color-gold);
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  opacity: 0.6;
}

.paper-slide {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 40rpx;
  background-color: #fff;
  border-radius: 4rpx;
  padding: 24rpx;
  transform: scaleY(0);
  transform-origin: bottom center;
  box-shadow: 0 4rpx 16rpx rgba(58, 42, 26, 0.1);
}

.paper-text {
  opacity: 0;
  margin-bottom: 20rpx;
}

.anim-text-placeholder {
  font-size: 24rpx;
  color: var(--color-ink-secondary);
}

.paper-sign {
  opacity: 0;
  text-align: right;
}

.anim-sign-placeholder {
  font-size: 24rpx;
  color: var(--color-ink-secondary);
  font-style: italic;
}
