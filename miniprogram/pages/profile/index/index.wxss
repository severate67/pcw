/* pages/profile/index/index.wxss — 我的样式 */

.page-container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 40rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 60vh;
  font-size: 28rpx;
  color: var(--color-ink-secondary);
}

.profile-header {
  background-color: var(--color-primary);
  padding: 48rpx 32rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 40rpx;
  color: #ffffff;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.user-intro {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.5;
}

.edit-btn {
  background-color: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
}

.tags-section {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 24rpx 24rpx 8rpx;
}

.stats-section {
  margin: 16rpx 24rpx;
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--color-primary);
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-ink-secondary);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: var(--color-gold);
  opacity: 0.5;
}

.menu-section {
  margin: 8rpx 24rpx;
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-bg);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  width: 40rpx;
  text-align: center;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-ink);
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--color-ink-secondary);
}

.member-section {
  margin: 8rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.member-title {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: bold;
  display: block;
  margin-bottom: 6rpx;
}

.member-sub {
  font-size: 22rpx;
  color: var(--color-ink-secondary);
}

.member-upgrade {
  background-color: var(--color-gold);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: bold;
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
}
