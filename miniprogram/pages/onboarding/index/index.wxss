/* pages/onboarding/index/index.wxss — 注册引导样式 */

.page-container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 60rpx;
}

.progress-bar {
  height: 6rpx;
  background-color: var(--color-paper);
}

.progress-fill {
  height: 100%;
  background-color: var(--color-accent);
  transition: width 0.3s ease;
}

.step-indicator {
  text-align: right;
  padding: 16rpx 32rpx 0;
}

.step-text {
  font-size: 24rpx;
  color: var(--color-ink-secondary);
}

.step-content {
  padding: 24rpx;
}

.step-header {
  margin-bottom: 32rpx;
}

.step-title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--color-primary);
  display: block;
  margin-bottom: 12rpx;
}

.step-sub {
  font-size: 26rpx;
  color: var(--color-ink-secondary);
}

.form-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.form-label {
  font-size: 24rpx;
  color: var(--color-ink-secondary);
  display: block;
  margin-bottom: 16rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.form-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.form-count {
  font-size: 22rpx;
  color: var(--color-ink-secondary);
}

.count-ok {
  color: var(--m-calm);
}

.form-input {
  width: 100%;
  font-size: 28rpx;
  color: var(--color-ink);
  padding: 8rpx 0;
  border-bottom: 1rpx solid var(--color-gold);
}

.form-textarea {
  width: 100%;
  font-size: 26rpx;
  color: var(--color-ink);
  line-height: 1.8;
  min-height: 120rpx;
}

.placeholder {
  color: var(--color-ink-secondary);
  opacity: 0.5;
}

/* 标签网格 */
.tags-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tag-option {
  padding: 14rpx 28rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: var(--color-ink-secondary);
  background-color: var(--color-paper);
  border: 2rpx solid var(--color-gold);
}

.tag-selected {
  background-color: var(--color-primary);
  color: #ffffff;
  border-color: var(--color-primary);
}

.tags-count {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-ink-secondary);
  margin-bottom: 32rpx;
}

/* 偏好选项 */
.options-row {
  display: flex;
  gap: 16rpx;
}

.option-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius: 8rpx;
  background-color: var(--color-bg);
  border: 2rpx solid var(--color-gold);
  font-size: 26rpx;
  color: var(--color-ink-secondary);
}

.option-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.option-active {
  background-color: var(--color-primary);
  color: #ffffff;
  border-color: var(--color-primary);
}

.options-col {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.option-row-item {
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  background-color: var(--color-bg);
  border: 2rpx solid var(--color-gold);
}

.option-row-item.option-active {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}

.option-title {
  font-size: 26rpx;
  color: var(--color-ink);
  display: block;
  margin-bottom: 4rpx;
  font-weight: bold;
}

.option-row-item.option-active .option-title,
.option-row-item.option-active .option-desc {
  color: #ffffff;
}

.option-desc {
  font-size: 22rpx;
  color: var(--color-ink-secondary);
}

/* 按钮 */
.next-btn {
  width: 100%;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: bold;
  margin-top: 24rpx;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.back-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
}

.next-btn-half,
.submit-btn {
  flex: 2;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-disabled {
  opacity: 0.4;
}
