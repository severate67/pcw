/* pages/match/profile/index.wxss — 对方主页样式 */

.page-container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 140rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 60vh;
  font-size: 28rpx;
  color: var(--color-ink-secondary);
}

.profile-header {
  background-color: var(--color-primary);
  padding: 60rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-wrap {
  margin-bottom: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 48rpx;
  color: #ffffff;
}

.profile-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.active-badge {
  font-size: 22rpx;
  color: var(--color-accent);
  background-color: rgba(255, 255, 255, 0.9);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.tags-section,
.intro-section,
.excerpt-section,
.preference-section {
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
}

.section-label {
  font-size: 22rpx;
  color: var(--color-ink-secondary);
  display: block;
  margin-bottom: 16rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.intro-text {
  font-size: 28rpx;
  color: var(--color-ink);
  line-height: 1.8;
}

.excerpt-text {
  font-size: 26rpx;
  color: var(--color-ink);
  line-height: 1.8;
  font-style: italic;
  display: block;
  margin-bottom: 8rpx;
}

.excerpt-note {
  font-size: 22rpx;
  color: var(--color-ink-secondary);
}

.preference-item {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  border-bottom: 1rpx solid var(--color-bg);
}

.preference-item:last-child {
  border-bottom: none;
}

.pref-label {
  font-size: 26rpx;
  color: var(--color-ink-secondary);
}

.pref-value {
  font-size: 26rpx;
  color: var(--color-ink);
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background-color: var(--color-bg);
  border-top: 1rpx solid var(--color-paper);
}

.skip-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
}

.write-btn {
  flex: 2;
  text-align: center;
  padding: 24rpx 0;
  font-weight: bold;
}
