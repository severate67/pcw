<!-- pages/match/profile/index.wxml — 对方主页 -->
<view class="page-container">

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <text>正在查看...</text>
  </view>

  <!-- 主页内容 -->
  <view wx:elif="{{profile}}" class="profile-content">

    <!-- 头部 -->
    <view class="profile-header">
      <view class="avatar-wrap">
        <view class="avatar">
          <text class="avatar-text">{{profile.nickname ? profile.nickname[0] : '匿'}}</text>
        </view>
      </view>
      <text class="profile-name">{{profile.nickname}}</text>
      <text wx:if="{{profile.isActiveRecently}}" class="active-badge">近期活跃</text>
    </view>

    <!-- 标签 -->
    <view class="tags-section card">
      <text class="section-label">兴趣标签</text>
      <view class="tags-wrap">
        <view
          wx:for="{{profile.tags}}"
          wx:key="*this"
          class="tag"
        >
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 一句话介绍 -->
    <view class="intro-section card">
      <text class="section-label">关于TA</text>
      <text class="intro-text">{{profile.intro}}</text>
    </view>

    <!-- 最近书写摘要（最多50字） -->
    <view wx:if="{{profile.recentExcerpt}}" class="excerpt-section card">
      <text class="section-label">最近写道</text>
      <text class="excerpt-text">{{profile.recentExcerpt}}</text>
      <text class="excerpt-note">（节选自最近一封信）</text>
    </view>

    <!-- 活跃偏好 -->
    <view class="preference-section card">
      <view class="preference-item">
        <text class="pref-label">活跃时段</text>
        <text class="pref-value">{{profile.activeTimeLabel || profile.active_time}}</text>
      </view>
      <view class="preference-item">
        <text class="pref-label">书信频率</text>
        <text class="pref-value">{{profile.letterFreqLabel || profile.letter_freq}}</text>
      </view>
    </view>

  </view>

  <!-- 底部操作栏 -->
  <view wx:if="{{profile}}" class="action-bar">
    <view class="btn btn-ghost skip-btn" bindtap="onSkip">跳过</view>
    <view class="btn btn-primary write-btn" bindtap="goToWrite">写信给TA</view>
  </view>

</view>
