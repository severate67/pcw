/* pages/match/index/index.wxss — 灵魂匹配样式 */

.page-container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 40rpx;
}

.page-header {
  padding: 40rpx 32rpx 24rpx;
  background-color: var(--color-primary);
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.page-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.rec-list {
  padding: 24rpx;
}

.rec-item {
  margin-bottom: 24rpx;
}

.rec-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 16rpx 0 0;
}

.skip-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  border: 2rpx solid var(--color-gold);
  color: var(--color-primary);
  border-radius: 8rpx;
}

.write-btn {
  flex: 2;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(196, 98, 45, 0.35);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-decoration {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.empty-moon {
  font-size: 80rpx;
  color: var(--color-gold);
}

.empty-star {
  font-size: 36rpx;
  color: var(--color-gold);
  opacity: 0.8;
}

.empty-star-sm {
  font-size: 24rpx;
  color: var(--color-ink-secondary);
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  color: var(--color-ink);
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--color-ink-secondary);
  text-align: center;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 60vh;
  font-size: 28rpx;
  color: var(--color-ink-secondary);
}
