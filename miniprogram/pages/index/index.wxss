/* pages/index/index.wxss — 首页样式 */

.page-container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 16rpx;
  background-color: var(--color-primary);
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.header-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.section {
  margin: 24rpx 24rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-more {
  font-size: 24rpx;
  color: var(--color-ink-secondary);
}

/* 心情区域 */
.mood-prompt {
  padding: 32rpx;
}

.mood-prompt-title {
  font-size: 34rpx;
  color: var(--color-primary);
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.mood-prompt-sub {
  font-size: 24rpx;
  color: var(--color-ink-secondary);
  display: block;
  margin-bottom: 24rpx;
}

.mood-done {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
}

.mood-done-text {
  font-size: 28rpx;
  color: var(--color-ink-secondary);
}

.mood-done-emoji {
  font-size: 40rpx;
  color: var(--m-calm);
}

/* 记忆区域 */
.memory-card {
  padding: 24rpx;
}

.memory-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.memory-date {
  font-size: 22rpx;
  color: var(--color-ink-secondary);
}

.memory-emotion-badge {
  border-radius: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  color: #fff;
}

.mood-happy { background-color: var(--m-happy); }
.mood-calm { background-color: var(--m-calm); }
.mood-sad { background-color: var(--m-sad); }
.mood-anxious { background-color: var(--m-anxious); }
.mood-mixed { background-color: var(--m-mixed); }

.memory-excerpt {
  font-size: 26rpx;
  color: var(--color-ink);
  line-height: 1.7;
}

/* 匹配推荐区域 */
.matches-scroll {
  width: 100%;
  white-space: nowrap;
}

.matches-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 4rpx 12rpx;
}

.match-item {
  display: inline-block;
  width: 280rpx;
  flex-shrink: 0;
}

.matches-empty {
  padding: 40rpx 20rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--color-ink-secondary);
}

/* 来信区域 */
.loading-wrap {
  padding: 40rpx;
  text-align: center;
}

.loading-text {
  font-size: 24rpx;
  color: var(--color-ink-secondary);
}
