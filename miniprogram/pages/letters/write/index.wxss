/* pages/letters/write/index.wxss — 写信页样式 */

.page-container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 160rpx;
}

.recipient-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: var(--color-paper);
  border-bottom: 1rpx solid var(--color-gold);
}

.recipient-label {
  font-size: 26rpx;
  color: var(--color-ink-secondary);
  margin-right: 8rpx;
}

.recipient-name {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: bold;
}

.letter-paper {
  margin: 24rpx;
  background-color: var(--color-paper);
  min-height: 600rpx;
  padding: 32rpx;
  position: relative;
  border-left: 6rpx solid var(--color-seal);
}

.title-input {
  width: 100%;
  font-size: 32rpx;
  color: var(--color-ink);
  font-family: 'Noto Serif SC', serif;
  padding: 8rpx 0;
}

.paper-divider {
  height: 1rpx;
  background-color: var(--color-gold);
  margin: 16rpx 0;
  opacity: 0.5;
}

.content-textarea {
  width: 100%;
  min-height: 400rpx;
  font-size: 28rpx;
  color: var(--color-ink);
  font-family: 'Noto Serif SC', serif;
  line-height: 1.9;
  padding: 8rpx 0;
}

.placeholder {
  color: var(--color-ink-secondary);
  opacity: 0.5;
}

.counter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-gold);
  opacity: 0.6;
}

.counter-text {
  font-size: 22rpx;
}

.counter-ok {
  color: var(--m-calm);
}

.counter-warn {
  color: var(--color-ink-secondary);
}

.counter-hint {
  font-size: 22rpx;
  color: var(--color-accent);
}

.paper-lines {
  margin: 0 24rpx;
  padding: 8rpx 0;
}

.paper-line {
  height: 1rpx;
  background-color: var(--color-gold);
  margin-bottom: 48rpx;
  opacity: 0.2;
}

.send-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background-color: var(--color-bg);
  border-top: 1rpx solid var(--color-paper);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.send-btn {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
  padding: 24rpx 0;
  text-align: center;
  border-radius: 8rpx;
}

.btn-disabled {
  opacity: 0.4;
}
