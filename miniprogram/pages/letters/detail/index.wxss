/* pages/letters/detail/index.wxss — 信件详情样式 */

.page-container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 120rpx;
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-ink-secondary);
}

.letter-container {
  min-height: 100vh;
}

.letter-content-wrap {
  padding: 24rpx;
}

.sender-bar {
  display: flex;
  align-items: center;
  background-color: var(--color-paper);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(58, 42, 26, 0.08);
}

.sender-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.avatar-placeholder {
  font-size: 32rpx;
  color: #ffffff;
}

.sender-info {
  flex: 1;
}

.sender-name {
  font-size: 28rpx;
  color: var(--color-ink);
  font-weight: bold;
  display: block;
}

.sender-time {
  font-size: 22rpx;
  color: var(--color-ink-secondary);
  margin-top: 4rpx;
  display: block;
}

.sender-arrow {
  font-size: 32rpx;
  color: var(--color-ink-secondary);
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background-color: var(--color-bg);
  border-top: 1rpx solid var(--color-paper);
  display: flex;
  gap: 16rpx;
}

.archive-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
}

.reply-btn {
  flex: 2;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  border-radius: 8rpx;
}

.reply-btn-half {
  flex: 2;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  font-size: 28rpx;
  color: var(--color-ink-secondary);
}
