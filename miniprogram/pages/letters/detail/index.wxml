<!-- pages/letters/detail/index.wxml — 信件详情 -->
<view class="page-container">

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-text">正在取信...</text>
  </view>

  <!-- 拆信动画 + 内容 -->
  <view wx:elif="{{letter}}" class="letter-container">

    <!-- 拆信动画组件 -->
    <open-animation
      wx:if="{{animState !== 'done'}}"
      letter-id="{{letterId}}"
      anim-state="{{animState}}"
      bind:animDone="onAnimDone"
    />

    <!-- 信件正文（动画完成后显示） -->
    <view wx:if="{{animState === 'done'}}" class="letter-content-wrap">

      <!-- 寄信人信息 -->
      <view class="sender-bar" bindtap="goToProfile">
        <view class="sender-avatar">
          <text class="avatar-placeholder">{{letter.senderNickname ? letter.senderNickname[0] : '匿'}}</text>
        </view>
        <view class="sender-info">
          <text class="sender-name">{{letter.senderNickname || '陌生人'}}</text>
          <text class="sender-time">{{letter.timeDisplay}}</text>
        </view>
        <text class="sender-arrow">›</text>
      </view>

      <!-- 信纸 -->
      <letter-paper letter="{{letter}}" />

      <!-- 操作栏 -->
      <view class="action-bar">
        <view class="btn btn-primary reply-btn" bindtap="onReply">
          <text>回信</text>
        </view>
      </view>

    </view>

  </view>

  <!-- 信件不存在 -->
  <view wx:elif="{{!loading}}" class="empty-state">
    <text>信件不见了</text>
  </view>

</view>
