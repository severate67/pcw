/* pages/letters/inbox/index.wxss — 收件箱样式 */

.page-container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 120rpx;
}

.tab-bar {
  display: flex;
  background-color: var(--color-paper);
  border-bottom: 1rpx solid var(--color-gold);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: var(--color-ink-secondary);
}

.tab-active {
  color: var(--color-primary);
  font-weight: bold;
  border-bottom: 4rpx solid var(--color-accent);
}

.letter-list {
  padding: 20rpx 24rpx;
}

.letter-item {
  margin-bottom: 16rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  color: var(--color-ink-secondary);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-state text {
  font-size: 30rpx;
  margin-bottom: 12rpx;
  color: var(--color-ink);
}

.empty-sub {
  font-size: 24rpx !important;
  color: var(--color-ink-secondary) !important;
  text-align: center;
  margin-bottom: 40rpx !important;
}

.empty-btn {
  margin-top: 16rpx;
  padding: 20rpx 60rpx;
}

.loading-wrap {
  padding: 40rpx;
  text-align: center;
}

.loading-text {
  font-size: 24rpx;
  color: var(--color-ink-secondary);
}

.no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 22rpx;
  color: var(--color-ink-secondary);
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: var(--color-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 24rpx rgba(196, 98, 45, 0.5);
  transition: transform 0.15s ease;
}

.fab:active {
  transform: scale(0.92);
}

.fab-icon {
  font-size: 40rpx;
}
